{
  "name": "llm-eval-harness",
  "version": "1.0.0",
  "description": "Benchmarks local (Ollama) and hosted (Anthropic) LLMs on GitHub issue classification, with statistical hygiene.",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "tsx src/eval/fetch.ts",
    "run": "tsx src/eval/run.ts",
    "report": "tsx src/eval/report.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "cli-table3": "^0.6.5",
    "ollama": "^0.6.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
